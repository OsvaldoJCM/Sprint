<section class="flex justify-center">
    <article id="register" class="flex flex-col justify-center items-center my-2">
        <form class="flex flex-col bg-gray-800 p-5 input-bordered">
            <h1 style="text-align: center; margin:1px">{{title}}</h1>
            <input type="text" id="email" placeholder="Type email" class="input input-bordered w-full max-w-xs my-1" />
            <input type="text" id="password" placeholder="Type password"
                class="input input-bordered w-full max-w-xs my-1" />
            <button type="button" class="btn btn-active" id="login">Login</button>
        </form>
    </article>
</section>