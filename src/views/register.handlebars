<section class="flex">
    <article id="register" class="flex flex-col justify-normal items-center my-2   basis-1/2">
        <form class="flex flex-col bg-gray-800 p-5 input-bordered">
            <h1 style="text-align: center; margin:1px">Registro</h1>

            <input type="text" id="foto" placeholder="Type foto" class="input input-bordered w-full max-w-xs my-1" />
            <input type="text" id="email" placeholder="Type email" class="input input-bordered w-full max-w-xs my-1" />
            <input type="text" id="password" placeholder="Type password"
                class="input input-bordered w-full max-w-xs my-1" />
            <input type="text" id="role" placeholder="Type role" class="input input-bordered w-full max-w-xs my-1" />
            <button type="button" class="btn btn-active" id="registrar">ADD USER</button>
        </form>
    </article>
    <article id="users" class="flex flex-wrap-reverse justify-normal basis-1/2">
        {{#each users}}

        <div class="card w-5/12 bg-gray-800 shadow-xl my-2 mx-1">
            <a href="/users/{{this.id}}" class="pt-3 ps-3">{{this.email}}</a>
            <figure><img src="{{this.photo}}" alt="{{this.photo}}" /></figure>
            <div class="card-body">
                <h2 class="card-title">{{this.email}}</h2>
                <h3 class="card-title"></h3>
                <div class="card-actions justify-start">
                    <a class="badge badge-outline p-3" href="/users/register?role={{this.role}}">Role :
                        {{this.role}}</a>
                </div>
                <div class="card-actions justify-end">
                    <a class="btn btn-active" href="/users/{{this._id}}">Details</a>
                </div>
            </div>
        </div>

        {{/each}}
    </article>
</section>