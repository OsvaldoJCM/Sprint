<section class="p-3" style="display: flex; justify-content: center; width: 100vw;">
    {{#if users}}
    <div class="card w-5/12 bg-gray-800 shadow-xl my-2 mx-1">
        <a href="/users/{{users.id}}" class="pt-3 ps-3">{{users.email}}</a>
        <figure><img src="{{users.photo}}" style="width: 50%;" alt="{{users.photo}}" /></figure>
        <div class="card-body">
            <h2 class="card-title">{{users.email}}</h2>
            <h3 class="card-title"></h3>
            <div class="card-actions justify-start">
                <a class="badge badge-outline p-3" href="/users/register?role={{users.role}}">Role :
                    {{users.role}}</a>
            </div>
            <div class="card-actions justify-end">
                <button class="btn btn-active">SEND EMAIL</button>
            </div>
        </div>
    </div>
    {{else}}
    <h1 class="bg-success-subtle p-2 text-center text-success w-100">NOT FOUND
        USER</h1>
    {{/if}}
</section>